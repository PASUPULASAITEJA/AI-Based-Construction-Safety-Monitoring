# SiteGuard AI — Environment Configuration Example
# Copy this file to .env and configure for your environment

# Security & Sessions
SECRET_KEY=siteguard-production-secret-key-change-in-production

# Network Host & Port
SITEGUARD_HOST=127.0.0.1
SITEGUARD_PORT=5000

# Computer Vision & Safety Rules
MODEL_CONFIDENCE=0.45
IOU_THRESHOLD=0.45
MIN_VIOLATION_FRAMES=10

# Paths
DATABASE_PATH=database/safety_monitor.db
MODEL_PATH=model/best.pt
CONFIG_PATH=data.yaml
